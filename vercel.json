{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/standalone/auth/google",
      "destination": "/api/google?action=start"
    },
    {
      "source": "/standalone/auth/session",
      "destination": "/api/google?action=session"
    },
    {
      "source": "/standalone/reset-chat",
      "destination": "/api/reset-chat"
    },
    {
      "source": "/standalone/:path*",
      "destination": "/api/native?path=:path*"
    },
    {
      "source": "/login",
      "destination": "/standalone-login.html"
    },
    {
      "source": "/signin-with-chatgpt",
      "destination": "/login"
    },
    {
      "source": "/coldchat-ui.js",
      "destination": "/api/chat-shell"
    },
    {
      "source": "/api/profile/:path*",
      "destination": "/api/native?path=profile/:path*"
    },
    {
      "source": "/api/profile",
      "destination": "/api/native?path=profile"
    },
    {
      "source": "/api/messages/:path*",
      "destination": "/api/native?path=messages/:path*"
    },
    {
      "source": "/api/messages",
      "destination": "/api/native?path=messages"
    },
    {
      "source": "/api/dms/:path*",
      "destination": "/api/native?path=dms/:path*"
    },
    {
      "source": "/api/dms",
      "destination": "/api/native?path=dms"
    },
    {
      "source": "/api/friends",
      "destination": "/api/native?path=friends"
    },
    {
      "source": "/api/moderation",
      "destination": "/api/native?path=moderation"
    },
    {
      "source": "/api/reactions",
      "destination": "/api/native?path=reactions"
    },
    {
      "source": "/api/stickers",
      "destination": "/api/native?path=stickers"
    },
    {
      "source": "/api/presence",
      "destination": "/api/native?path=presence"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://coldchat.flaviadervishaj.chatgpt.site/assets/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://coldchat.flaviadervishaj.chatgpt.site/api/:path*"
    }
  ]
}
